#!/bin/bash
clear

# Ensure the directory for temporary files and database exists
mkdir -p $HOME/.cache/grok

# Create a temporary file for the Python script
TMP_FILE=$(mktemp $HOME/.cache/grok/grok_script.XXXXXX.py)

# Write the Python code to the temporary file
cat > "$TMP_FILE" << EOF
import sys
import os
import sqlite3
import argparse
from openai import OpenAI

# Parse command-line arguments
parser = argparse.ArgumentParser(description="Interact with Grok 3 from the terminal.")
parser.add_argument("--history", type=int, default=0, help="Number of past interactions to include (0 for all)")
args = parser.parse_args()

# Retrieve the API key from the environment variable
api_key = os.environ.get("XAI_API_KEY")
if not api_key:
    print("Error: XAI_API_KEY environment variable not set")
    sys.exit(1)

# Initialize the OpenAI client with xAI's endpoint
client = OpenAI(api_key=api_key, base_url="https://api.x.ai/v1")

# Set up SQLite database connection
db_dir = os.path.expanduser("~/.cache/grok")
os.makedirs(db_dir, exist_ok=True)
db_path = os.path.join(db_dir, "chat_history.db")
conn = sqlite3.connect(db_path)
cursor = conn.cursor()

# Create chat history table if it doesn’t exist
cursor.execute("""
    CREATE TABLE IF NOT EXISTS chat_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_query TEXT,
        grok_response TEXT,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
    )
""")
conn.commit()

# Function to retrieve past interactions from the database
def get_past_interactions(limit):
    if limit == 0:
        cursor.execute("SELECT user_query, grok_response FROM chat_history ORDER BY id ASC")
        rows = cursor.fetchall()
    else:
        cursor.execute("SELECT user_query, grok_response FROM chat_history ORDER BY id DESC LIMIT ?", (limit,))
        rows = cursor.fetchall()[::-1]  # Reverse to chronological order
    return rows

# Display welcome message
print("Grok2: ")
print(" ")

# Main interaction loop
while True:
    # Get user input
    user_input = input("ifnot1the0: ").strip()
    if user_input.lower() in ["exit", "quit"]:
        break
    elif user_input.lower().startswith("clear history"):
        parts = user_input.lower().split()
        if len(parts) == 3 and parts[2] == 'all':
            try:
                cursor.execute("DELETE FROM chat_history")
                conn.commit()
                if cursor.rowcount > 0:
                    print("Entire history cleared.")
                else:
                    print("History was already empty.")
            except sqlite3.Error as e:
                print(f"Database error: {e}")
            continue
        elif len(parts) == 2:
            n = 1
        elif len(parts) == 3 and parts[2].isdigit():
            n = int(parts[2])
        else:
            print("Invalid command. Use 'clear history', 'clear history N', or 'clear history all'.")
            continue
        # Remove last n questions
        try:
            cursor.execute("SELECT COUNT(*) FROM chat_history")
            total = cursor.fetchone()[0]
            if total == 0:
                print("No history to clear.")
            else:
                to_remove = min(n, total)
                cursor.execute("""
                    DELETE FROM chat_history
                    WHERE id IN (
                        SELECT id FROM chat_history
                        ORDER BY id DESC
                        LIMIT ?
                    )
                """, (to_remove,))
                conn.commit()
                if to_remove == 1:
                    print("Removed last question.")
                else:
                    print(f"Removed last {to_remove} questions.")
        except sqlite3.Error as e:
            print(f"Database error: {e}")
        continue
    else:
        # Retrieve past interactions
        past_interactions = get_past_interactions(args.history)
        # Construct the message list for the API
        messages = []
        for query, response in past_interactions:
            messages.append({"role": "user", "content": query})
            messages.append({"role": "assistant", "content": response})
        messages.append({"role": "user", "content": user_input})
        try:
            # Send request to Grok API
            response = client.chat.completions.create(
                model="grok-2-1212",
                messages=messages
            )
            grok_response = response.choices[0].message.content
            # Display Grok’s response
            print(" ")
            print("Grok:", grok_response)
            print(" ")
            # Store the new interaction in the database
            cursor.execute(
                "INSERT INTO chat_history (user_query, grok_response) VALUES (?, ?)",
                (user_input, grok_response)
            )
            conn.commit()
        except Exception as e:
            print(f"Error: {e}")

# Close the database connection
conn.close()
EOF

# Run the Python script with all arguments passed to the Bash script
python3 "$TMP_FILE" "$@"

# Check if the Python code executed successfully
if [ $? -eq 0 ]; then
    echo " "
    echo "Python code executed successfully"
else
    echo "Error: Python code failed to execute"
    exit 1
fi

# Remove the temporary file
rm "$TMP_FILE"
