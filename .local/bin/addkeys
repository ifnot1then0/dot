#!/bin/bash
################################################################################################
###       Restore script from external device for GPG keys, SSH, passwords, and hosts file   ###
################################################################################################

# Define mount point
MOUNT_POINT="/mnt"

# Define destinations for restoration (adjust paths as needed)
RESTORE_DESTINATIONS=(
  "$HOME/.gnupg"                    # GPG keys
  "$HOME/.ssh"                      # SSH keys
  "$HOME/.local/share/password-store"  # Password store
  "/etc/hosts"                      # Hosts file
  "/etc/ssh/sshd_config"            # SSH daemon config
)

# Define log file
LOGFILE="$HOME/log/addkeys.log"

# Create log directory if it doesn’t exist
mkdir -p "$(dirname "$LOGFILE")"

# Function to check if a command exists
command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# Function to log messages silently with timestamp
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOGFILE"
}

# Function to handle errors: log, echo to stderr, and exit
error_exit() {
    log "Error: $1"
    echo "Error: $1" >&2
    exit 1
}

# Function to handle warnings: log and echo to console
warn() {
    log "Warning: $1"
    echo "Warning: $1"
}

# Check for required commands (available on Arch Linux)
for cmd in mount umount lsblk rsync; do
  if ! command_exists "$cmd"; then
    error_exit "$cmd is not installed. Please install it with 'pacman -S $cmd' and try again."
  fi
done

log "Restore script started"

# Ask user if they want to proceed with restoration
echo "Do you want to restore your keys from the external device? (y/n)"
read -r response
case "$response" in
  [yY]|[yY][eE][sS])
    log "User chose to proceed with restore"
    echo "Proceeding with restore..."
    ;;
  [nN]|[nN][oO])
    log "User chose to exit"
    echo "Exiting."
    exit 0
    ;;
  *)
    log "Invalid input: $response"
    echo "Invalid input. Exiting."
    exit 1
    ;;
esac

# Show available devices and prompt for selection
echo "Available devices:"
lsblk
echo ""
echo "Enter the device partition to mount (e.g., sdb1):"
read -r device
log "User selected device: /dev/$device"

# Validate device existence
if [ ! -b "/dev/$device" ]; then
  error_exit "/dev/$device is not a valid block device."
fi

# Check if mount point is already in use
if mountpoint -q "$MOUNT_POINT"; then
  error_exit "$MOUNT_POINT is already mounted. Please unmount it first."
fi

# Mount the device
echo "Mounting /dev/$device to $MOUNT_POINT..."
if ! sudo mount "/dev/$device" "$MOUNT_POINT"; then
  error_exit "Failed to mount /dev/$device."
fi
log "Mounted /dev/$device to $MOUNT_POINT"

# Warn user about overwriting files and confirm
echo ""
echo "WARNING: This will overwrite existing files in the destination locations."
echo "Type 'yes' to proceed with restoring, anything else to abort:"
read -r confirm
log "User was warned about overwriting files"
if [ "$confirm" != "yes" ]; then
  log "User chose not to proceed with restoring"
  echo "Aborting. Unmounting $MOUNT_POINT..."
  if ! sudo umount "$MOUNT_POINT"; then
    warn "Failed to unmount $MOUNT_POINT"
  else
    log "Unmounted $MOUNT_POINT"
  fi
  exit 1
fi
log "User confirmed to proceed with restoring"

# Restore items from /mnt to their original locations
echo "Restoring backup files from $MOUNT_POINT..."
log "Starting restore of backup files"
for dest in "${RESTORE_DESTINATIONS[@]}"; do
  src="$MOUNT_POINT/$(basename "$dest")"
  if [ -d "$src" ]; then
    log "Restoring directory $src to $dest"
    if [[ "$dest" == /etc/* ]]; then
      if ! sudo rsync -a --quiet "$src/" "$dest/"; then
        warn "Failed to restore $src to $dest"
      fi
    else
      if ! rsync -a --quiet "$src/" "$dest/"; then
        warn "Failed to restore $src to $dest"
      fi
    fi
  elif [ -f "$src" ]; then
    log "Restoring file $src to $dest"
    if [[ "$dest" == /etc/* ]]; then
      if ! sudo rsync -a --quiet "$src" "$dest"; then
        warn "Failed to restore $src to $dest"
      fi
    else
      if ! rsync -a --quiet "$src" "$dest"; then
        warn "Failed to restore $src to $dest"
      fi
    fi
  else
    warn "Item $src does not exist or is not a file/directory."
  fi
done
log "Restore operation complete"
echo "Restore operation complete."

# Set proper permissions for restored items
log "Setting permissions for restored items"

# For $HOME/.ssh
if [ -d "$HOME/.ssh" ]; then
  chmod 700 "$HOME/.ssh"
  find "$HOME/.ssh" -type f -not -name "*.pub" -exec chmod 600 {} \;
  find "$HOME/.ssh" -type f -name "*.pub" -exec chmod 644 {} \;
  log "Set permissions for $HOME/.ssh"
fi

# For $HOME/.gnupg
if [ -d "$HOME/.gnupg" ]; then
  chmod 700 "$HOME/.gnupg"
  find "$HOME/.gnupg" -type f -exec chmod 600 {} \;
  log "Set permissions for $HOME/.gnupg"
fi

# For $HOME/.local/share/password-store
if [ -d "$HOME/.local/share/password-store" ]; then
  chmod 700 "$HOME/.local/share/password-store"
  find "$HOME/.local/share/password-store" -type f -exec chmod 600 {} \;
  log "Set permissions for $HOME/.local/share/password-store"
fi

# For /etc/hosts
if [ -f "/etc/hosts" ]; then
  sudo chmod 644 "/etc/hosts"
  log "Set permissions for /etc/hosts"
fi

# For /etc/ssh/sshd_config
if [ -f "/etc/ssh/sshd_config" ]; then
  sudo chmod 644 "/etc/ssh/sshd_config"
  log "Set permissions for /etc/ssh/sshd_config"
fi

# Unmount the device
echo "Unmounting $MOUNT_POINT..."
if ! sudo umount "$MOUNT_POINT"; then
  error_exit "Failed to unmount $MOUNT_POINT."
fi
log "Unmounted $MOUNT_POINT"

# Final confirmation
echo "Restore is complete and the device is unmounted."
echo "Current device status:"
lsblk

log "Script completed successfully"
