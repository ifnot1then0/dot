#!/bin/bash
################################################################################################
###       Backup script to external device for GPG keys, SSH, passwords, and hosts file      ###
################################################################################################

# Default mount point
MOUNT_POINT="/mnt"

# Directories and files to back up
BACKUP_ITEMS=(
  "$HOME/.gnupg"
  "$HOME/.ssh"
  "$HOME/.local/share/password-store"
  "/etc/hosts"
  "/etc/ssh/sshd_config"
)

# Define log file
LOGFILE="$HOME/log/savekeys.log"

# Create log directory if it doesn’t exist
mkdir -p "$(dirname "$LOGFILE")"

# Function to check if a command exists
command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# Function to log messages with timestamp
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOGFILE"
}

# Function to handle errors: log, echo to stderr, and exit
error_exit() {
    log "Error: $1"
    echo "Error: $1" >&2
    exit 1
}

# Function to handle warnings: log and echo to console
warn() {
    log "Warning: $1"
    echo "Warning: $1"
}

# Ensure required commands are available
for cmd in mount umount lsblk rsync; do
  if ! command_exists "$cmd"; then
    error_exit "$cmd is not installed. Please install it and try again."
  fi
done

log "Backup script started"

# Step 1: Ask user if they want to backup their keys
echo "Do you want to backup your keys? (y/n)"
read -r response
case "$response" in
  [yY]|[yY][eE][sS])
    log "User chose to proceed with backup"
    echo "Proceeding with backup..."
    ;;
  [nN]|[nN][oO])
    log "User chose to exit"
    echo "Exiting."
    exit 0
    ;;
  *)
    log "Invalid input: $response"
    echo "Invalid input. Exiting."
    exit 1
    ;;
esac

# Step 2: Identify and mount the external device
echo "Available devices:"
lsblk
echo ""
echo "Enter the device partition to mount (e.g., sdb1):"
read -r device
log "User selected device: /dev/$device"

# Validate device existence
if [ ! -b "/dev/$device" ]; then
  error_exit "/dev/$device is not a valid block device."
fi

# Check if mount point is already in use
if mountpoint -q "$MOUNT_POINT"; then
  error_exit "$MOUNT_POINT is already mounted. Please unmount it first."
fi

# Mount the device
echo "Mounting /dev/$device to $MOUNT_POINT..."
if ! sudo mount "/dev/$device" "$MOUNT_POINT"; then
  error_exit "Failed to mount /dev/$device."
fi
log "Mounted /dev/$device to $MOUNT_POINT"

# Step 3: Warn user and confirm erasing the mounted device
echo ""
echo "WARNING: All files on $MOUNT_POINT will be erased."
echo "Type 'yes' to proceed with erasing, anything else to abort:"
read -r confirm
log "User was warned about erasing files on $MOUNT_POINT"
if [ "$confirm" != "yes" ]; then
  log "User chose not to proceed with erasing"
  echo "Aborting. Unmounting $MOUNT_POINT..."
  if ! sudo umount "$MOUNT_POINT"; then
    warn "Failed to unmount $MOUNT_POINT"
  else
    log "Unmounted $MOUNT_POINT"
  fi
  exit 1
fi
log "User confirmed to proceed with erasing"

# Erase all files on the mounted device
echo "Erasing all files on $MOUNT_POINT..."
if ! sudo rm -rf "$MOUNT_POINT"/*; then
  error_exit "Failed to erase files on $MOUNT_POINT."
fi
log "Erased all files on $MOUNT_POINT"
echo "Erase complete."

# Step 4: Copy the backup files to the mounted device
echo "Copying backup files to $MOUNT_POINT..."
log "Starting copy of backup files"
for item in "${BACKUP_ITEMS[@]}"; do
  if [ -e "$item" ]; then
    log "Copying $item to $MOUNT_POINT"
    if ! sudo rsync -a --quiet "$item" "$MOUNT_POINT"; then
      warn "Failed to copy $item"
    fi
  else
    warn "$item does not exist, skipping."
  fi
done
log "Copy operation complete"
echo "Copy operation complete."

# Step 5: Unmount the device and confirm completion
echo "Unmounting $MOUNT_POINT..."
if ! sudo umount "$MOUNT_POINT"; then
  error_exit "Failed to unmount $MOUNT_POINT."
fi
log "Unmounted $MOUNT_POINT"

echo "Copy is complete and the device is unmounted."
echo "Current device status:"
lsblk

log "Script completed successfully"
