#!/bin/bash

# Define source and destination directories
SRC="/var/lib/transmission/Downloads/"
DST="/$HOME/dls/torrents/"

# Check if the source directory exists
if [ ! -d "$SRC" ]; then
    echo "Error: Source directory $SRC does not exist."
    exit 1
fi

# Inform the user that the copy process is starting
echo "Starting copy from $SRC to $DST"

# Perform the copy using rsync
rsync -av "$SRC" "$DST"

# Confirm completion
echo "Copy completed."
