#!/bin/bash

# Define the log file location
LOGFILE="$HOME/log/git_repos.log"

# Ensure log directory exists
mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null

# Logging function
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOGFILE" 2>/dev/null
}

# Define SSH key and pass entry
SSH_KEY="$HOME/.ssh/id_rsa"       # Path to your SSH private key
PASS_KEY="key"                    # Replace with your actual 'pass' entry (e.g., 'ssh/github')

# Set PASSWORD_STORE_DIR based on the script's usage
export PASSWORD_STORE_DIR="$HOME/.local/share/password-store"

# Retrieve the passphrase from the pass entry
passphrase=$(pass "$PASS_KEY")
if [ $? -ne 0 ]; then
    echo "Failed to retrieve passphrase from pass" >&2
    log "ERROR: Failed to retrieve passphrase from pass"
    exit 1
fi

# Function to check if SSH agent is running
is_ssh_agent_running() {
    if [ -n "$SSH_AGENT_PID" ] && kill -0 "$SSH_AGENT_PID" 2>/dev/null; then
        return 0  # Agent is running
    else
        return 1  # Agent is not running
    fi
}

# Start SSH agent if not running
if ! is_ssh_agent_running; then
    eval $(ssh-agent -s)
    log "Started SSH agent with PID $SSH_AGENT_PID"
fi

# Add SSH key to the agent using expect
if expect -c "
set timeout 10
spawn ssh-add $SSH_KEY
expect {
    \"Enter passphrase for $SSH_KEY:\" {
        send \"$passphrase\r\"
        expect eof
    }
    eof
}
"; then
    log "Successfully added SSH key to agent"
else
    echo "Failed to add SSH key to agent" >&2
    log "ERROR: Failed to add SSH key to agent"
    exit 1
fi

# Define the templates for git config
git_local_template=$(cat <<'EOF'
[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "local"]
	url = git@server:/home/git/dev/$name_of_branch.git
	fetch = refs/heads/*:refs/remotes/local/*
[branch "$name_of_branch"]
	remote = local
	merge = refs/heads/$name_of_branch
EOF
)

git_remote_template=$(cat <<'EOF'
[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "github"]
	url = git@github.com:ifnot1then0/$name_of_branch.git
	fetch = +refs/heads/*:refs/remotes/github/*
[branch "$name_of_branch"]
	remote = github
	merge = refs/heads/$name_of_branch
EOF
)

# Define the list of directories with local repositories
directories_local_repo=(
    "$HOME/.config/bookmenu:bookmenu"
    "$HOME/.config/qutebrowser:surf"
    "$HOME/.local/share/password-store:pass"
    "$HOME/.local/share/newsboat:newsboat"
    "$HOME/.local/usr:usr"
    "$HOME/dls:dls"
    "$HOME/fls/crs:crs"
    "$HOME/fls/doc:doc"
    "$HOME/fls/jnk:jnk"
    "$HOME/fls/note:note"
    "$HOME/gms/KSP:KSP"
    "$HOME/gms/minecraft:minecraft"
    "$HOME/gms/RDR2:RDR2"
    "$HOME/med/aud:aud"
    "$HOME/med/mus:mus"
    "$HOME/med/vid:vid"
    "$HOME/pic:pic"
    "$HOME/tmp:tmp"
    "$HOME/prg/dotgit/bash:bash"
    "$HOME/prg/dotgit/python:python"
    "$HOME/prg/dotgit/web:web"
)

# Define the list of directories with remote repositories
directories_remote_repo=(
    "$HOME/prg/github/ifnot1then0/dabs:dabs"
    "$HOME/prg/github/ifnot1then0/dmenu:dmenu"
    "$HOME/prg/github/ifnot1then0/dot:dot"
    "$HOME/prg/github/ifnot1then0/dwm:dwm"
    "$HOME/prg/github/ifnot1then0/dwmblocks:dwmblocks"
    "$HOME/prg/github/ifnot1then0/st:st"
)

# Function to process repositories
process_repos() {
    local type="$1"
    shift
    local repos=("$@")
    for entry in "${repos[@]}"; do
        IFS=':' read -r dir repo_name <<< "$entry"
        log "Processing directory: $dir with repo name: $repo_name as $type"

        # Determine the actual remote name based on type
        if [ "$type" = "local" ]; then
            remote_name="local"
        else
            remote_name="github"
        fi

        # Try to create the directory if it doesn't exist
        if [ ! -d "$dir" ]; then
            if mkdir -p "$dir" 2>> "$LOGFILE"; then
                echo "Created directory: $dir"
                log "Successfully created directory: $dir"
            else
                echo "Failed to create directory: $dir" >&2
                log "ERROR: Failed to create directory: $dir"
                continue
            fi
        fi

        # Check if Git repository exists
        if [ ! -d "$dir/.git" ]; then
            if git init "$dir" > /dev/null 2>> "$LOGFILE"; then
                log "Successfully initialized Git repository in: $dir"
                if git -C "$dir" branch -m "$repo_name" > /dev/null 2>> "$LOGFILE"; then
                    log "Successfully renamed branch to: $repo_name in $dir"
                    # Set git config based on type
                    if [ "$type" = "local" ]; then
                        echo "${git_local_template//\$name_of_branch/$repo_name}" > "$dir/.git/config"
                        log "Set local repository config for: $repo_name in $dir"
                    else
                        echo "${git_remote_template//\$name_of_branch/$repo_name}" > "$dir/.git/config"
                        log "Set remote repository config for: $repo_name in $dir"
                    fi
                    echo "Created repository: $repo_name"
                    # Perform git pull after repository creation
                    echo "Pulling repository: $repo_name from $remote_name"
                    if git -C "$dir" pull "$remote_name" "$repo_name" > /dev/null 2>> "$LOGFILE"; then
                        log "Successfully pulled $type repository: $repo_name from $remote_name"
                    else
                        echo "Failed to pull $type repository: $repo_name from $remote_name" >&2
                        log "ERROR: Failed to pull $type repository: $repo_name from $remote_name"
                    fi
                else
                    echo "Failed to rename branch in $dir" >&2
                    log "ERROR: Failed to rename branch to $repo_name in $dir"
                fi
            else
                echo "Failed to initialize Git repository in $dir" >&2
                log "ERROR: Failed to initialize Git repository in $dir"
            fi
        else
            log "Repository already exists in $dir, skipping"
        fi
    done
}

# Determine which repositories to process based on argument
case "$1" in
    local)
        process_repos "local" "${directories_local_repo[@]}"
        ;;
    remote)
        process_repos "remote" "${directories_remote_repo[@]}"
        ;;
    "")
        process_repos "local" "${directories_local_repo[@]}"
        process_repos "remote" "${directories_remote_repo[@]}"
        ;;
    *)
        echo "Usage: $0 [local|remote]" >&2
        exit 1
        ;;
esac
