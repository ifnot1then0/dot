#!/bin/bash

# Script to check multiple Git repositories for local and remote changes
# Uses SSH key authentication with an SSH agent to avoid repeated passphrase prompts

# Define the log file location
LOGFILE="$HOME/log/git_check.log"

# Define SSH key and pass entry
SSH_KEY="$HOME/.ssh/id_rsa"       # Path to your SSH private key
PASS_KEY="key"              # Replace with your actual 'pass' entry (e.g., 'ssh/github')

# Array of repositories with format "path:identifier"
repos=(
    "$HOME/.config/bookmenu:bookmenu"
    "$HOME/.config/qutebrowser:surf"
    "$HOME/.local/share/password-store:pass"
    "$HOME/.local/share/newsboat:newsboat"
    "$HOME/.local/bin:bin"
    "$HOME/dls:dls"
    "$HOME/fls/crs:crs"
    "$HOME/fls/doc:doc"
    "$HOME/fls/jnk:jnk"
    "$HOME/fls/note:note"
    "$HOME/gms/KSP:KSP"
    "$HOME/gms/minecraft:minecraft"
    "$HOME/gms/RDR2:RDR2"
    "$HOME/med/aud:aud"
    "$HOME/med/mus:mus"
    "$HOME/med/vid:vid"
    "$HOME/pic:pic"
    "$HOME/tmp:tmp"
    "$HOME/prg/dotgit/bash:bash"
    "$HOME/prg/dotgit/python:python"
    "$HOME/prg/dotgit/web:web"
    "$HOME/prg/gitlab/cabs:cabs"
    "$HOME/prg/gitlab/dmenu:dmenu"
    "$HOME/prg/gitlab/dot:dot"
    "$HOME/prg/gitlab/dwm:dwm"
    "$HOME/prg/gitlab/dwmblocks:dwmblocks"
    "$HOME/prg/gitlab/st:st"
)

# Create log directory if it doesn’t exist
mkdir -p "$HOME/log"

# Log function to append messages with timestamps to the log file silently
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOGFILE"
}

# Log script start
log "Script started"

# Check if SSH agent is running; start it if not
if [ -z "$SSH_AUTH_SOCK" ]; then
    log "Starting SSH agent..."
    if ! eval $(ssh-agent -s); then
        log "Failed to start SSH agent"
        exit 1
    fi
else
    log "SSH agent is already running"
fi

# Retrieve the passphrase from pass
passphrase=$(pass show "$PASS_KEY" | head -n1)
if [ -z "$passphrase" ]; then
    log "Failed to retrieve passphrase from pass"
    exit 1
fi

# Add the SSH key to the agent using expect
log "Adding SSH key to agent..."
if expect << EOF
set timeout 10
spawn ssh-add "$SSH_KEY"
expect {
    "Enter passphrase for $SSH_KEY:" {
        send "$passphrase\r"
        expect {
            "Identity added: *" {
                exit 0
            }
            "Bad passphrase" {
                exit 1
            }
            eof
        }
    }
    "Identity is already added: *" {
        exit 0
    }
    eof
}
EOF
then
    log "SSH key added successfully or already added"
else
    log "Failed to add SSH key"
    exit 1
fi

# Array to store output lines for repositories with changes or errors
output_lines=()

# Loop through each repository in the repos array
for repo in "${repos[@]}"; do
    # Extract path and identifier from the repo string
    path=${repo%:*}
    identifier=${repo#*:}

    # Check if the path is a Git repository
    if ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>> "$LOGFILE"; then
        log "Path $path is not a Git repository or access denied, skipping"
        continue
    fi

    # Fetch the latest remote data quietly
    if ! git -C "$path" fetch --quiet 2>> "$LOGFILE"; then
        log "Fetch failed for repository: $identifier"
        output_lines+=("$identifier --error (fetch failed)")
        continue
    fi

    # Check for local changes (uncommitted, staged, or untracked files)
    status=$(git -C "$path" status --porcelain)
    has_local_changes="false"
    if [ -n "$status" ]; then
        has_local_changes="true"
    fi

    # Check for remote changes (behind or ahead of upstream)
    has_remote_changes="false"
    if git -C "$path" rev-parse --abbrev-ref @{upstream} >/dev/null 2>&1; then
        behind=$(git -C "$path" rev-list --count HEAD..@{upstream})
        ahead=$(git -C "$path" rev-list --count @{upstream}..HEAD)
        if [ "$behind" -gt 0 ] || [ "$ahead" -gt 0 ]; then
            has_remote_changes="true"
        fi
    fi

    # If there are any changes, prepare the output line
    if [ "$has_local_changes" = "true" ] || [ "$has_remote_changes" = "true" ]; then
        types=""
        if [ "$has_local_changes" = "true" ]; then
            types="local"
        fi
        if [ "$has_remote_changes" = "true" ]; then
            if [ -n "$types" ]; then
                types="$types, remote"
            else
                types="remote"
            fi
        fi
        output_lines+=("$identifier --changes ($types)")
    fi
done

# Log summary of the run
log "Checked ${#repos[@]} repositories, ${#output_lines[@]} have changes or errors"

# Output the results to the console
if [ ${#output_lines[@]} -eq 0 ]; then
    echo "git --no-change"
else
    for line in "${output_lines[@]}"; do
        echo "$line"
    done
fi

# Log script completion
log "Script finished"
